# CareerForge environment — copy to .env and fill in values:  cp .env.example .env
# .env is gitignored; NEVER commit real values. Safe local defaults only here.
#
# API variables are zod-validated at boot (apps/api/src/env.ts — the single
# source of truth; a test asserts every schema key is documented in this file).

# ── Postgres (docker compose) ────────────────────────────────────────────
POSTGRES_USER=careerforge
POSTGRES_PASSWORD=generate-a-local-password
POSTGRES_DB=careerforge
POSTGRES_PORT=5432

# ── apps/api ─────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# CareerForge uses the 4300 (web) / 4301 (api) pair: Binnie — a permanent
# local service — owns :3000 and its neighborhood (relocated 2026-07-15).
API_PORT=4301
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Must match the POSTGRES_* values above.
DATABASE_URL=postgres://careerforge:generate-a-local-password@localhost:5432/careerforge
# Integration tests NEVER use DATABASE_URL directly: they derive it with the
# database name suffixed `_test` (careerforge_test), creating that DB on the
# same server as needed. Uncomment only to point tests somewhere else.
# TEST_DATABASE_URL=
# Parallel-dev harness (M5-03): each git worktree can run the full gate trio
# and the e2e suite concurrently against one shared Postgres by scoping its
# scratch DBs and e2e ports. All default to today's values when unset; the
# per-worktree recipe is in docs/RUNBOOKS.md.
#   TEST_DB_SUFFIX  — the per-lane knob: appended to BOTH derived scratch DB
#                     names (careerforge_test<suffix>, careerforge_e2e<suffix>),
#                     credentials still derived from DATABASE_URL. e.g. "_a1".
#   E2E_WEB_PORT / E2E_API_PORT — the Playwright web/api ports (default 4310/4311).
#   E2E_DATABASE_URL — full-URL escape hatch for the e2e DB (mirrors
#                     TEST_DATABASE_URL); wins over TEST_DB_SUFFIX.
# TEST_DB_SUFFIX=
# E2E_WEB_PORT=4310
# E2E_API_PORT=4311
# E2E_DATABASE_URL=

# ── auth (M0-07, ADR-0007) ──────────────────────────────────────────────
# The single user, created at first boot iff no user has this email.
# NOTE: boot only reads AUTH_BOOTSTRAP_PASSWORD when first creating the user.
# After changing it, run `pnpm auth:sync-bootstrap` to apply the new value
# (re-hashes in place and revokes all sessions). Min 12 chars.
AUTH_BOOTSTRAP_EMAIL=you@example.com
AUTH_BOOTSTRAP_PASSWORD=generate-a-strong-password
# Browser origin allowed on mutating requests (CSRF origin check) AND the
# CORS allowlist (M0-10) — one definition of "the web app". Must match the
# apps/web dev server origin (nuxt.config.ts devServer.port), which the dev
# script's port preflight enforces (apps/web/scripts/assert-port-free.mjs).
WEB_APP_ORIGIN=http://localhost:4300
# Host the API binds to (main.ts listen). Loopback for local dev; the Docker
# image sets 0.0.0.0 so the container is reachable (M10-02).
API_HOST=127.0.0.1
# Optional: path to the built static SPA payload (apps/web `nuxt generate`
# output). When set, apps/api serves it via @fastify/static for a same-origin
# deploy (M10-02); unset locally = API-only. The Docker image sets /app/web-dist.
WEB_DIST_DIR=
# Demo posture (M10-03). Both default OFF; set to `1` to turn on. DEMO_MODE turns
# the public demo container on: LLM-draft POSTs return DEMO_DISABLED, mutations
# are per-IP rate-limited, boot is fail-closed on the seed marker, and a present
# ANTHROPIC_API_KEY refuses to boot (demo instances are keyless by decision).
# TRUST_PROXY reads the client IP from X-Forwarded-For - set ONLY behind a
# trusted front (the demo's ALB/App Runner); leaving it off keeps request.ip
# unspoofable locally. Both stay unset (off) for local/dev/test.
DEMO_MODE=
TRUST_PROXY=

# ── M13-01 backup & restore (scripts/db-backup.mjs, scripts/db-restore-verify.mjs) ──
# Names documented here; real values live only in .env. These are read by the
# root backup scripts, NOT by the apps/api zod env schema. See docs/RUNBOOKS.md.
# BACKUP_DIR (required for db:backup): a private directory OUTSIDE the repo AND
# off the primary disk (an external encrypted drive, or a cloud-synced folder).
# The script FAILS if it resolves inside the repo, or shares the repo's disk
# device unless BACKUP_SAME_DEVICE_OK is set. The real path never enters the repo.
BACKUP_DIR=
# Delete this script's own dated artifacts older than N days after a successful
# run (default 30). Never touches files the script did not create.
BACKUP_RETENTION_DAYS=30
# How old the newest backup artifact may be before the 09:00 liveness check
# alerts STALE (default 26 hours - one nightly cycle plus slack). Set it HERE
# rather than in your shell: launchd supplies no environment, so a shell export
# never reaches the scheduled run. A value of 0, a value below 1, a non-numeric
# value, or this key present with an EMPTY value are all refused with a loud
# ERROR rather than silently falling back to the default.
BACKUP_LIVENESS_MAX_AGE_HOURS=26
# Set to 1 ONLY for a cloud-synced folder that leaves the machine (same local
# device, off-machine via sync). Acknowledges the off-primary-disk residual
# honestly; leave unset for an external drive on its own device.
BACKUP_SAME_DEVICE_OK=
# Encryption (cloud-synced branch): when BACKUP_AGE_RECIPIENT is set, db:backup
# pipes BOTH the dump and the profile tar through `age -r <recipient>` (landing as
# .dump.age / .tar.age); the manifest stays plaintext (public table names + integer
# counts only). Leave unset for an external encrypted drive (the volume is the
# boundary). The recipient is a PUBLIC age key; the private half never comes here.
BACKUP_AGE_RECIPIENT=
# db:restore:verify reads this to open a .dump.age: the PATH to the age IDENTITY
# (private key) file, which lives OUTSIDE the repo and is created by the operator
# at the attended session -- never committed, never printed. Only the path is set
# here. (An operator-provided already-decrypted dump via --file needs neither var.)
BACKUP_AGE_IDENTITY_FILE=
# Optional: name the compose Postgres container to target. Needed only when SEVERAL
# are running (multi-lane worktree dev) - db:backup / db:restore:verify then FAIL
# LOUD and ask for this rather than risk backing up the wrong database. With one
# container running it is auto-discovered by label; leave this unset.
BACKUP_PG_CONTAINER=
# Optional, read ONLY by scripts/launchd/careerforge-backup (the launchd wrapper):
# when BACKUP_DIR lives on an SMB share that a reboot silently unmounts, the
# wrapper remounts it before running db:backup. BACKUP_SMB_URL is the share URL
# (smb://<host>/<share>); the credential stays in the login keychain, never here.
# BACKUP_SMB_MOUNT_POINT is the exact mount path BACKUP_DIR expects (usually
# /Volumes/<share>). The wrapper reads plain unquoted KEY=value lines from .env
# (it never sources the file). Set BOTH or NEITHER: one without the other fails
# loud, and with neither set the remount block is skipped entirely.
BACKUP_SMB_URL=
BACKUP_SMB_MOUNT_POINT=

# apps/web (Nuxt reads NUXT_-prefixed vars into runtimeConfig at runtime).
# Where the SPA reaches the API; default matches API_PORT above.
NUXT_PUBLIC_API_BASE=http://localhost:4301

# ── packages/llm (M1-04, ADR-0005) ──────────────────────────────────────
# Anthropic API key — NAME DOCUMENTED ONLY, never a value. Provisioned
# manually in the Anthropic Console (dedicated `careerforge` workspace,
# $20/mo spend cap); rotation runbook: docs/RUNBOOKS.md. Read via validated
# env by packages/llm only — never argv, never logged. Needed only for live
# use (pnpm llm:smoke now, extraction from M1-05); pnpm test runs entirely
# on the mocked provider without it.
ANTHROPIC_API_KEY=
# Model for LLM calls (ADR-0005: claude-sonnet-5 for extraction).
LLM_MODEL=claude-sonnet-5
