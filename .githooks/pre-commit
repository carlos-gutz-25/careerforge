#!/usr/bin/env bash
# Pre-commit guard (BACKLOG M0-01): block secrets/PII from entering the
# public repo. Enable with:  git config core.hooksPath .githooks
set -euo pipefail

# ---------------------------------------------------------------------------
# 0. THE REPOSITORY MUST BE USABLE, OR EVERY CHECK BELOW SILENTLY PASSES.
#
# Added 2026-08-14 after a measured fail-open. In a lane devcontainer the
# bind-mounted worktree root is owned by root (0:0) while .git is owned by
# node (1000:1000), so git 2.39 refuses every operation with "detected
# dubious ownership". `git diff --cached` then degrades to `git diff
# --no-index` mode ("unknown option `cached'"), the profile guard below
# matches nothing, and gitleaks swallows the git error and prints
# "no leaks found" after scanning ~0 bytes.
#
# Demonstrated: with a GitHub PAT and docs/profile/resume.md both staged, the
# unguarded hook exited 0. With this check in place it exits 1. A green gate
# that inspected nothing is worse than no gate, because green is a claim.
# ---------------------------------------------------------------------------
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "BLOCKED: not a usable git work tree, so no check below can be trusted." >&2
  echo "In a devcontainer this is usually 'dubious ownership'. Fix with:" >&2
  echo "  git config --global --add safe.directory \"\$(pwd)\"" >&2
  echo "(--global, not --system: this hook runs as an unprivileged user who" >&2
  echo " cannot write /etc/gitconfig. The seat image sets the system-wide" >&2
  echo " entry at build time; this is the escape hatch everywhere else.)" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# 1. Hard stop if anything under docs/profile/ is ever staged (belt-and-braces
#    on top of .gitignore - `git add -f` would otherwise bypass it).
#
# TWO defects were found here by adversarial review on 2026-08-15 and both are
# fixed below. Neither was theoretical; both were reproduced.
#
# (a) SIGPIPE fail-open. Piping the staged list into `grep -q` lets grep exit
#     on the first match, which SIGPIPEs the writer (status 141); `pipefail`
#     then makes the MATCHING case a non-zero pipeline, so the `if` reads it
#     as "no match" and the guard fails open exactly when it should fire.
#     An earlier attempt at this fix captured the list into a variable first
#     and kept the pipe - which only moved the SIGPIPE from `git` to `printf`
#     and left the failure intact (reproduced at 2500 staged paths, exit 0
#     with docs/profile/ staged). The real fix is to remove the PIPE, not to
#     change who writes into it: a here-string has no second process and so
#     no SIGPIPE is possible.
#
# (b) Non-ASCII bypass. git quotes paths containing non-ASCII bytes by
#     default, so a staged accented filename under docs/profile/ (an e-acute
#     in "Resume", say) is reported as
#     "docs/profile/r\303\251sum\303\251.md" - with a leading double quote,
#     which means `^docs/profile/` never anchors and the guard is bypassed.
#     docs/profile/ holds real resumes and accented filenames are entirely
#     plausible there. `-c core.quotePath=false` emits the path raw.
# ---------------------------------------------------------------------------
if ! staged="$(git -c core.quotePath=false diff --cached --name-only)"; then
  echo "BLOCKED: could not list staged files; refusing to guess." >&2
  exit 1
fi

if grep -q '^docs/profile/' <<<"$staged"; then
  echo "BLOCKED: docs/profile/ contains real career data and must never be committed." >&2
  echo "Staged files:" >&2
  grep '^docs/profile/' <<<"$staged" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# 2. Secret scan. The container ships a pinned gitleaks (see
#    .devcontainer/Dockerfile); the host installs it via Homebrew.
# ---------------------------------------------------------------------------
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "BLOCKED: gitleaks is not installed (brew install gitleaks)." >&2
  echo "This repo is public; commits without secret scanning are not allowed." >&2
  exit 1
fi

scan_log="$(mktemp)"
trap 'rm -f "$scan_log"' EXIT

if ! gitleaks git --pre-commit --staged --redact --verbose >"$scan_log" 2>&1; then
  cat "$scan_log" >&2
  exit 1
fi
cat "$scan_log"

# ---------------------------------------------------------------------------
# 3. A pass that inspected nothing is not a pass.
#
# Belt-and-braces on top of check 0: any future condition that leaves gitleaks
# unable to read the index (a bind-mount sync race was observed once during
# the 2026-08-14 verification) would otherwise reach here as a clean exit 0.
#
# This check was REWRITTEN on 2026-08-15 after adversarial review proved the
# first version wrong in both directions:
#
#   FALSE BLOCK - it fired whenever any file was staged and gitleaks scanned
#   0 bytes, so a commit that only DELETES files (which adds zero bytes, so
#   zero bytes is the correct scan) was rejected outright, as was a commit
#   staging only an empty .gitkeep. With core.hooksPath set, that breaks
#   ordinary work and trains the operator to reach for --no-verify, which
#   disables the entire secret scan. A gate that teaches its own bypass is
#   worse than the gate it replaced.
#
#   FALSE PASS - it fired only on a literal "scanned ~0 bytes" match, so a
#   gitleaks that printed NOTHING (an output-format change, a crash caught by
#   the exit code, an empty log) sailed through. Its own comment claimed it
#   would "trip loudly rather than go quiet" on drift. It went quiet.
#
# The fix is to assert POSITIVELY. Parse the byte count out of the scan log
# and require it to exist; a log we cannot parse is an unverifiable scan and
# blocks. Only then compare it against whether the staged diff actually
# contained content to scan.
# ---------------------------------------------------------------------------
scanned_bytes="$(sed -nE 's/.*scanned ~?([0-9]+) bytes.*/\1/p' "$scan_log" | tail -n 1)"

if [ -z "$scanned_bytes" ]; then
  echo "BLOCKED: could not find a scanned-byte count in the gitleaks output." >&2
  echo "The scan cannot be verified, so its exit 0 is not evidence." >&2
  echo "This usually means the gitleaks output format changed; update this hook." >&2
  cat "$scan_log" >&2
  exit 1
fi

# Does the staged diff actually carry content to scan? numstat reports added
# and deleted line counts per path, and "-" for both on a binary file. A pure
# deletion has zero added lines and no binary rows, and legitimately scans
# zero bytes. Anything else must have been inspected.
staged_adds="$(git diff --cached --numstat | awk '
  $1 == "-" { binary = 1; next }
  { added += $1 }
  END { print (binary ? "binary" : added + 0) }
')"

if [ "$staged_adds" != "0" ] && [ "$scanned_bytes" -eq 0 ]; then
  echo "BLOCKED: gitleaks scanned 0 bytes while the staged diff adds content." >&2
  echo "The scan did not inspect the staged content; this is not a pass." >&2
  echo "Staged adds: $staged_adds" >&2
  grep -v '^$' <<<"$staged" | sed 's/^/  staged: /' >&2
  exit 1
fi
