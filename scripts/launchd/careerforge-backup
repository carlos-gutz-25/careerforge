#!/bin/zsh -l
# M13-01 (F-5) nightly backup wrapper. Named so launchd and the macOS
# "Login Items & Extensions" UI show "careerforge-backup" instead of a bare
# "zsh". (The "unidentified developer" label is inherent to any unsigned,
# self-installed LaunchAgent and is not removable without an Apple Developer
# code-signing certificate.)
#
# The login shell (`-l`) sources the user profile so pnpm/node/age/docker are on
# PATH under launchd's minimal environment. It runs the exact same
# `pnpm db:backup` the operator runs by hand.
#
# ---------------------------------------------------------------------------
# WHERE THE DESTINATION COMES FROM (M16-10 D24)
#
# BACKUP_DIR arrives in the PROCESS ENVIRONMENT, from the agent's plist
# `EnvironmentVariables`, and `scripts/db-backup.mjs` resolves
# `process.env.BACKUP_DIR ?? env.BACKUP_DIR` at both of its call sites - so the
# plist wins and `.env` is only the fallback. This wrapper therefore reads no
# config of its own and deliberately has no resolution logic to get wrong.
#
# THE SMB REMOUNT BLOCK THAT USED TO LIVE HERE IS DELETED, NOT DISABLED. It ran
# an `osascript -e "mount volume ..."` against BACKUP_SMB_URL before every
# backup, because the old destination was an SMB share that a reboot silently
# unmounted. That share (brownie-alien, .97) was powered off on 2026-09-01 and
# the destination is now an SD card that is either mounted or absent - there is
# nothing to remount, and the block's only remaining effect was to fail the
# 02:00 job before `pnpm db:backup` ever ran. Do not restore it for a future
# network destination without re-reading the injection note in
# `careerforge-backup-liveness`: that osascript form interpolated a .env value
# into AppleScript source.
set -e

REPO_ROOT="${0:A:h}/../.."

cd "$REPO_ROOT"
exec pnpm db:backup
