<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<!--
  M13-01 (F-5) nightly backup LaunchAgent TEMPLATE. Runs `pnpm db:backup` at the
  NC-3 time (02:00 local). Installation is operator-manual (see docs/RUNBOOKS.md
  "Backup & restore"): copy this file to ~/Library/LaunchAgents/, substitute the
  three placeholders, then `launchctl bootstrap gui/$UID ...`.

  Placeholders (the operator fills these in at install; nothing host-specific is
  committed):
    __HOME__        absolute home dir       (e.g. /Users/<you>)
    __REPO_ROOT__   absolute repo checkout  (e.g. /Users/<you>/code/careerforge)
    __BACKUP_DIR__  absolute backup destination on the removable card
                    (e.g. /Volumes/<CARD>/careerforge-backups)

  M16-10 D24: BACKUP_DIR is supplied HERE, in EnvironmentVariables, and is no
  longer read from .env by the wrapper. `scripts/db-backup.mjs` resolves
  `process.env.BACKUP_DIR ?? env.BACKUP_DIR` at both call sites, so the value
  below wins and a stale `.env` entry cannot silently point the nightly backup
  at a destination that no longer exists - which is what kept this job failing
  after the SMB share was powered off. TZ carries the IANA zone, never a fixed
  offset and never a bare "CDT", so the stamps this job produces follow DST by
  themselves.

  The job runs the named `careerforge-backup` wrapper (a `#!/bin/zsh -l` script)
  so launchd and the macOS Login Items UI show a meaningful name, not a bare
  "zsh". The login shell sources the user profile so Homebrew's PATH (node, pnpm,
  and `age`) is present under launchd's minimal env.

  launchd COALESCES missed StartCalendarInterval runs: if the laptop is asleep at
  02:00, the job fires once shortly after the next wake, so an overnight-off
  machine still gets a backup. RunAtLoad is false: bootstrapping the agent does
  NOT trigger an immediate backup (the operator runs the first one by hand).

  Output is value-free by construction (filenames, table/file counts, byte sizes,
  deleted-count only), so logging to ~/Library/Logs is safe.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.careerforge.backup</string>

    <key>ProgramArguments</key>
    <array>
      <string>__REPO_ROOT__/scripts/launchd/careerforge-backup</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>BACKUP_DIR</key>
      <string>__BACKUP_DIR__</string>
      <key>TZ</key>
      <string>America/Chicago</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>2</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/careerforge-backup.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/careerforge-backup.log</string>

    <key>ProcessType</key>
    <string>Background</string>
  </dict>
</plist>
